--- /dev/null
+++ b/server/security.js
@@ -0,0 +1,143 @@
+import crypto from 'node:crypto';
+
+const SESSION_VERSION = 1;
+const MAX_SESSION_TOKEN_LENGTH = 8192;
+
+function b64url(value) {
+  return Buffer.from(value).toString('base64url');
+}
+
+function sign(body, secret) {
+  return crypto.createHmac('sha256', secret).update('67/superadmin/session/v1\0').update(body).digest('base64url');
+}
+
+export function timingSafeEqualString(a, b) {
+  const aa = Buffer.from(String(a ?? ''), 'utf8');
+  const bb = Buffer.from(String(b ?? ''), 'utf8');
+  return aa.length === bb.length && crypto.timingSafeEqual(aa, bb);
+}
+
+export function createSession({ username, secret, ttlMs, now = Date.now() }) {
+  const payload = {
+    v: SESSION_VERSION,
+    sub: username,
+    sid: crypto.randomBytes(24).toString('base64url'),
+    csrf: crypto.randomBytes(24).toString('base64url'),
+    iat: now,
+    exp: now + ttlMs,
+  };
+  const body = b64url(JSON.stringify(payload));
+  return { token: `${body}.${sign(body, secret)}`, payload };
+}
+
+export function verifySession(token, secret, now = Date.now()) {
+  const raw = String(token ?? '');
+  if (!raw || raw.length > MAX_SESSION_TOKEN_LENGTH) return null;
+  const [body, signature, extra] = raw.split('.');
+  if (!body || !signature || extra) return null;
+  const expected = sign(body, secret);
+  if (!timingSafeEqualString(signature, expected)) return null;
+  try {
+    const payload = JSON.parse(Buffer.from(body, 'base64url').toString('utf8'));
+    if (payload?.v !== SESSION_VERSION || typeof payload.sub !== 'string' || !payload.sid || !payload.csrf) return null;
+    if (!Number.isSafeInteger(payload.iat) || !Number.isSafeInteger(payload.exp)) return null;
+    if (payload.iat > now + 30_000 || payload.exp <= now || payload.exp - payload.iat > 24 * 60 * 60_000) return null;
+    return payload;
+  } catch {
+    return null;
+  }
+}
+
+export function parseCookie(cookieHeader, name) {
+  for (const part of String(cookieHeader ?? '').split(';')) {
+    const index = part.indexOf('=');
+    if (index < 0) continue;
+    const key = part.slice(0, index).trim();
+    if (key !== name) continue;
+    try { return decodeURIComponent(part.slice(index + 1).trim()); } catch { return null; }
+  }
+  return null;
+}
+
+export function csrfMatches(session, supplied) {
+  return Boolean(session?.csrf) && timingSafeEqualString(session.csrf, supplied);
+}
+
+export function sessionCookieName(production) {
+  return production ? '__Host-67-superadmin' : '67-superadmin';
+}
+
+export function sessionCookieOptions(production, maxAge) {
+  return {
+    httpOnly: true,
+    secure: production,
+    sameSite: 'strict',
+    path: '/',
+    maxAge,
+  };
+}
+
+function secretAad(context) {
+  const normalized = String(context || 'github-token').trim();
+  if (!/^[a-z0-9_-]{1,64}$/i.test(normalized)) throw new Error('Invalid encryption context.');
+  return Buffer.from(`67/superadmin/${normalized}/v1`, 'utf8');
+}
+
+export function encryptSecret(plaintext, key, context = 'github-token') {
+  if (!key || key.length !== 32) throw new Error('Encryption key is unavailable.');
+  const iv = crypto.randomBytes(12);
+  const cipher = crypto.createCipheriv('aes-256-gcm', key, iv);
+  cipher.setAAD(secretAad(context));
+  const ciphertext = Buffer.concat([cipher.update(String(plaintext), 'utf8'), cipher.final()]);
+  const tag = cipher.getAuthTag();
+  return { v: 1, alg: 'A256GCM', iv: iv.toString('base64'), tag: tag.toString('base64'), ciphertext: ciphertext.toString('base64') };
+}
+
+export function decryptSecret(record, key, context = 'github-token') {
+  if (!record || record.v !== 1 || record.alg !== 'A256GCM') throw new Error('Unsupported encrypted secret.');
+  const decipher = crypto.createDecipheriv('aes-256-gcm', key, Buffer.from(record.iv, 'base64'));
+  decipher.setAAD(secretAad(context));
+  decipher.setAuthTag(Buffer.from(record.tag, 'base64'));
+  return Buffer.concat([decipher.update(Buffer.from(record.ciphertext, 'base64')), decipher.final()]).toString('utf8');
+}
+
+export function redactSecrets(value) {
+  return String(value ?? '')
+    .replace(/https:\/\/[^\s/@:]+:[^\s/@]+@github\.com/gi, 'https://github.com')
+    .replace(/github_pat_[A-Za-z0-9_]+/g, 'github_pat_***')
+    .replace(/gh[pousr]_[A-Za-z0-9_]+/g, 'gh*_***')
+    .replace(/(?:AKIA|ASIA)[0-9A-Z]{16}/g, 'AWS_ACCESS_KEY_REDACTED')
+    .replace(/AIza[0-9A-Za-z_-]{30,}/g, 'GOOGLE_API_KEY_REDACTED')
+    .replace(/xox[baprs]-[A-Za-z0-9-]+/g, 'xox*-***')
+    .replace(/(?:sk|rk)_live_[A-Za-z0-9]+/g, '*_live_***')
+    .replace(/\beyJ[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{5,}\.[A-Za-z0-9_-]{8,}\b/g, 'JWT_REDACTED')
+    .replace(/-----BEGIN (?:ENCRYPTED |RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/g, 'PRIVATE_KEY_REDACTED');
+}
+
+export function ipFingerprint(ip, secret) {
+  return crypto.createHmac('sha256', secret).update(String(ip ?? 'unknown')).digest('hex').slice(0, 16);
+}
+
+export async function hashPassword(password) {
+  const raw = String(password ?? '');
+  if (raw.length < 14 || raw.length > 256) throw new Error('Password must be between 14 and 256 characters.');
+  const salt = crypto.randomBytes(16);
+  const derived = await new Promise((resolve, reject) => {
+    crypto.scrypt(raw, salt, 64, { N: 16384, r: 8, p: 1, maxmem: 64 * 1024 * 1024 }, (error, key) => error ? reject(error) : resolve(key));
+  });
+  return `scrypt$16384$8$1$${salt.toString('base64url')}$${derived.toString('base64url')}`;
+}
+
+export async function verifyPasswordHash(password, encoded) {
+  const parts = String(encoded ?? '').split('$');
+  if (parts.length !== 6 || parts[0] !== 'scrypt') return false;
+  const N = Number(parts[1]); const r = Number(parts[2]); const p = Number(parts[3]);
+  if (N !== 16384 || r !== 8 || p !== 1) return false;
+  let salt; let expected;
+  try { salt = Buffer.from(parts[4], 'base64url'); expected = Buffer.from(parts[5], 'base64url'); } catch { return false; }
+  if (salt.length < 16 || expected.length !== 64) return false;
+  const derived = await new Promise((resolve) => {
+    crypto.scrypt(String(password ?? ''), salt, 64, { N, r, p, maxmem: 64 * 1024 * 1024 }, (error, key) => resolve(error ? null : key));
+  });
+  return Boolean(derived) && derived.length === expected.length && crypto.timingSafeEqual(derived, expected);
+}
