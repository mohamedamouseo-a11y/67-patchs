+++ b/server/githubSecurity.test.js
@@ -0,0 +1,47 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  assertSafeBranch, blockedPathReason, createExecutionAuthorization, isSafeSourcePath,
+  normalizeGitHubRepo, scanTextForSecrets, verifyExecutionAuthorization,
+} from './githubSecurity.js';
+
+test('GitHub repositories are restricted to github.com owner/repo identities', () => {
+  assert.equal(normalizeGitHubRepo('OpenAI/example.git').fullName, 'OpenAI/example');
+  assert.equal(normalizeGitHubRepo('git@github.com:OpenAI/example.git').fullName, 'OpenAI/example');
+  assert.throws(() => normalizeGitHubRepo('https://evil.example/OpenAI/example'));
+  assert.throws(() => normalizeGitHubRepo('http://github.com/OpenAI/example'));
+  assert.throws(() => normalizeGitHubRepo('https://github.com/OpenAI/example?x=1'));
+  assert.throws(() => normalizeGitHubRepo('https://github.com/a/b/extra'));
+});
+
+test('branch validation rejects command/ref injection shapes', () => {
+  assert.equal(assertSafeBranch('feature/safe-branch_1'), 'feature/safe-branch_1');
+  for (const value of ['--upload-pack=x', '../main', 'a..b', 'a b', 'x@{1}', '.hidden']) assert.throws(() => assertSafeBranch(value));
+});
+
+test('secret/runtime paths and workflow mutations are blocked', () => {
+  for (const value of ['.env', 'server/.env.production', '.ssh/id_ed25519', 'uploads/customer.jpg', 'node_modules/x.js', '.github/workflows/deploy.yml', 'backup/app.tar.gz']) {
+    assert.ok(blockedPathReason(value), value);
+  }
+  assert.equal(blockedPathReason('src/pages/AdminDashboard.jsx'), null);
+  assert.equal(isSafeSourcePath('src/pages/AdminDashboard.jsx'), true);
+  assert.equal(isSafeSourcePath('.env.example'), true);
+  assert.equal(isSafeSourcePath('SECURITY_DEPLOYMENT.md'), true);
+  assert.equal(isSafeSourcePath('random-dir/new.js'), false);
+});
+
+test('secret scanning detects high confidence credential patterns', () => {
+  assert.deepEqual(scanTextForSecrets('const x = "hello"'), []);
+  assert.ok(scanTextForSecrets('const token="ghp_abcdefghijklmnopqrstuvwxyz123456"').includes('GitHub token'));
+  assert.ok(scanTextForSecrets('-----BEGIN PRIVATE KEY-----').includes('private key'));
+});
+
+test('execution authorization is signed and expires', () => {
+  const secret = 'x'.repeat(64);
+  const now = Date.now();
+  const payload = { v: 1, repo: 'owner/repo', branch: 'main', action: 'push', expectedAction: 'push', pushMode: 'review', fingerprint: 'fp', sessionBinding: 'session-hash', fileCount: 0, checks: { verify: 'passed', tests: 'passed', build: 'passed' }, iat: now, exp: now + 60_000 };
+  const token = createExecutionAuthorization(payload, secret);
+  assert.equal(verifyExecutionAuthorization(token, secret, now + 1_000).fingerprint, 'fp');
+  assert.throws(() => verifyExecutionAuthorization(`${token}x`, secret, now + 1_000));
+  assert.throws(() => verifyExecutionAuthorization(token, secret, now + 61_000));
+});
