+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import os from 'node:os';
+import path from 'node:path';
+import { execFileSync } from 'node:child_process';
+import { GitHubService } from './github.js';
+
+function git(cwd, ...args) {
+  return execFileSync('git', args, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] }).trim();
+}
+
+async function makeRepo() {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), '67-git-security-'));
+  git(root, 'init', '-b', 'main');
+  git(root, 'config', 'user.name', 'Test');
+  git(root, 'config', 'user.email', 'test@example.com');
+  await fs.writeFile(path.join(root, 'README.md'), 'baseline\n');
+  git(root, 'add', 'README.md');
+  git(root, 'commit', '-m', 'baseline');
+  return root;
+}
+
+function serviceFor(root) {
+  return new GitHubService({
+    config: {
+      repositoryRoot: root,
+      dataDir: path.join(root, '.private-test-data'),
+      sessionSecret: 's'.repeat(64),
+      gitAuthorName: '67 Test',
+      gitAuthorEmail: 'test@example.com',
+    },
+    store: null,
+    getToken: async () => 'github_pat_test_value_that_is_long_enough',
+    audit: async () => {},
+  });
+}
+
+test('unsafe executable local Git configuration is rejected', async (t) => {
+  const root = await makeRepo();
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  git(root, 'config', 'filter.evil.clean', 'sh -c "echo owned"');
+  await assert.rejects(() => serviceFor(root).assertSafeLocalGitConfig(), /Unsafe local Git configuration/);
+});
+
+test('local Git configuration cannot weaken HTTPS/TLS verification', async (t) => {
+  const root = await makeRepo();
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  git(root, 'config', 'http.sslVerify', 'false');
+  await assert.rejects(() => serviceFor(root).assertSafeLocalGitConfig(), /http\.sslverify/);
+});
+
+test('outgoing history catches a secret path even when a later commit deletes it', async (t) => {
+  const root = await makeRepo();
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  const baseline = git(root, 'rev-parse', 'HEAD');
+  git(root, 'update-ref', 'refs/remotes/origin/main', baseline);
+
+  await fs.writeFile(path.join(root, '.env'), 'GITHUB_TOKEN=ghp_abcdefghijklmnopqrstuvwxyz123456\n');
+  git(root, 'add', '-f', '.env');
+  git(root, 'commit', '-m', 'bad secret commit');
+  git(root, 'rm', '.env');
+  git(root, 'commit', '-m', 'remove secret again');
+
+  const blockers = await serviceFor(root).scanOutgoingHistory({
+    ahead: 2,
+    remoteSha: baseline,
+    binding: { branch: 'main', selected: { fullName: 'owner/repo', repoUrl: 'https://github.com/owner/repo.git' } },
+  });
+  assert.ok(blockers.some((item) => item.path === '.env'), JSON.stringify(blockers));
+});
+
+test('review manifest changes when working-tree content changes with the same Git status', async (t) => {
+  const root = await makeRepo();
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  git(root, 'remote', 'add', 'origin', 'https://github.com/owner/repo.git');
+  const service = serviceFor(root);
+  const selection = { repo: 'owner/repo', branch: 'main', permissions: { push: true } };
+
+  await fs.writeFile(path.join(root, 'README.md'), 'first reviewed content\n');
+  const first = await service.rawState(selection, { fetch: false });
+  const firstFingerprint = service.stateFingerprint(first, 'push');
+  assert.equal(first.files.length, 1);
+
+  await fs.writeFile(path.join(root, 'README.md'), 'different content, same status\n');
+  const second = await service.rawState(selection, { fetch: false });
+  const secondFingerprint = service.stateFingerprint(second, 'push');
+  assert.notEqual(firstFingerprint, secondFingerprint);
+});
+
+test('staged index is rejected when it differs from reviewed content', async (t) => {
+  const root = await makeRepo();
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  git(root, 'remote', 'add', 'origin', 'https://github.com/owner/repo.git');
+  const service = serviceFor(root);
+  const selection = { repo: 'owner/repo', branch: 'main', permissions: { push: true } };
+
+  await fs.writeFile(path.join(root, 'README.md'), 'reviewed content\n');
+  const reviewed = await service.rawState(selection, { fetch: false });
+  await fs.writeFile(path.join(root, 'README.md'), 'tampered after review\n');
+  git(root, 'add', 'README.md');
+  await assert.rejects(() => service.assertIndexMatchesManifest(reviewed.contentManifest), /differs from the reviewed/);
+});
+
+test('outgoing history scans secret content in an otherwise safe source path', async (t) => {
+  const root = await makeRepo();
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  const baseline = git(root, 'rev-parse', 'HEAD');
+  git(root, 'update-ref', 'refs/remotes/origin/main', baseline);
+  await fs.mkdir(path.join(root, 'src'), { recursive: true });
+  await fs.writeFile(path.join(root, 'src', 'config.js'), 'export const token = "ghp_abcdefghijklmnopqrstuvwxyz123456";\n');
+  git(root, 'add', 'src/config.js');
+  git(root, 'commit', '-m', 'bad source secret');
+  await fs.writeFile(path.join(root, 'src', 'config.js'), 'export const token = null;\n');
+  git(root, 'commit', '-am', 'remove source secret');
+
+  const blockers = await serviceFor(root).scanOutgoingHistory({
+    ahead: 2,
+    remoteSha: baseline,
+    binding: { branch: 'main', selected: { fullName: 'owner/repo', repoUrl: 'https://github.com/owner/repo.git' } },
+  });
+  assert.ok(blockers.some((item) => item.path === 'src/config.js' && /GitHub token detected/.test(item.reason)), JSON.stringify(blockers));
+});
+
+test('outgoing merge commits are blocked for manual review', async (t) => {
+  const root = await makeRepo();
+  t.after(() => fs.rm(root, { recursive: true, force: true }));
+  const baseline = git(root, 'rev-parse', 'HEAD');
+  git(root, 'update-ref', 'refs/remotes/origin/main', baseline);
+  git(root, 'checkout', '-b', 'feature');
+  await fs.writeFile(path.join(root, 'feature.txt'), 'feature\n');
+  git(root, 'add', 'feature.txt');
+  git(root, 'commit', '-m', 'feature');
+  git(root, 'checkout', 'main');
+  await fs.writeFile(path.join(root, 'main.txt'), 'main\n');
+  git(root, 'add', 'main.txt');
+  git(root, 'commit', '-m', 'main change');
+  git(root, 'merge', '--no-ff', 'feature', '-m', 'merge feature');
+
+  const blockers = await serviceFor(root).scanOutgoingHistory({
+    ahead: 3,
+    remoteSha: baseline,
+    binding: { branch: 'main', selected: { fullName: 'owner/repo', repoUrl: 'https://github.com/owner/repo.git' } },
+  });
+  assert.ok(blockers.some((item) => /merge commit/.test(item.reason)), JSON.stringify(blockers));
+});
diff --git a/server/http.integration.test.js b/server/http.integration.test.js
