new file mode 100644
index 0000000..23d0241
--- /dev/null
+++ b/scripts/hash-admin-password.js
@@ -0,0 +1,45 @@
+import { stdin, stdout } from 'node:process';
+import readline from 'node:readline';
+import { hashPassword } from '../server/security.js';
+
+function readHidden(prompt) {
+  if (!stdin.isTTY || !stdout.isTTY || typeof stdin.setRawMode !== 'function') {
+    throw new Error('Run this command in an interactive TTY so the password is not echoed.');
+  }
+  readline.emitKeypressEvents(stdin);
+  stdin.setRawMode(true);
+  stdin.resume();
+  stdout.write(prompt);
+  return new Promise((resolve, reject) => {
+    let value = '';
+    const cleanup = () => {
+      stdin.off('keypress', onKeypress);
+      stdin.setRawMode(false);
+      stdin.pause();
+      stdout.write('\n');
+    };
+    const onKeypress = (text, key = {}) => {
+      if (key.ctrl && key.name === 'c') {
+        cleanup();
+        reject(new Error('Cancelled.'));
+        return;
+      }
+      if (key.name === 'return' || key.name === 'enter') {
+        cleanup();
+        resolve(value);
+        return;
+      }
+      if (key.name === 'backspace') {
+        value = value.slice(0, -1);
+        return;
+      }
+      if (!key.ctrl && !key.meta && text) value += text;
+    };
+    stdin.on('keypress', onKeypress);
+  });
+}
+
+const password = await readHidden('Superadmin password (14+ chars): ');
+const confirmation = await readHidden('Confirm password: ');
+if (password !== confirmation) throw new Error('Passwords do not match.');
+stdout.write(`${await hashPassword(password)}\n`);
diff --git a/server/config.js b/server/config.js
new file mode 100644
index 0000000..c0722b3
--- /dev/null
+++ b/server/config.js
@@ -0,0 +1,84 @@
+import crypto from 'node:crypto';
+import path from 'node:path';
+
+function env(name, fallback = '') {
+  return String(process.env[name] ?? fallback).trim();
+}
+
+function intEnv(name, fallback, min, max) {
+  const value = Number(process.env[name] ?? fallback);
+  if (!Number.isSafeInteger(value) || value < min || value > max) return fallback;
+  return value;
+}
+
+function parseEncryptionKey(raw) {
+  if (!raw) return null;
+  const candidates = [];
+  try { candidates.push(Buffer.from(raw, 'base64')); } catch {}
+  try { candidates.push(Buffer.from(raw, 'hex')); } catch {}
+  candidates.push(Buffer.from(raw, 'utf8'));
+  return candidates.find((value) => value.length === 32) ?? null;
+}
+
+function isPathInside(parent, child) {
+  const relative = path.relative(path.resolve(parent), path.resolve(child));
+  return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));
+}
+
+function validateAllowedOrigin(raw, production) {
+  if (!raw) return production ? 'SUPERADMIN_ALLOWED_ORIGIN is required in production.' : null;
+  try {
+    const parsed = new URL(raw);
+    if (parsed.origin !== raw || parsed.username || parsed.password || parsed.pathname !== '/' || parsed.search || parsed.hash) {
+      return 'SUPERADMIN_ALLOWED_ORIGIN must be an exact origin with no path, credentials, query, or fragment.';
+    }
+    if (production && parsed.protocol !== 'https:') return 'SUPERADMIN_ALLOWED_ORIGIN must use HTTPS in production.';
+    if (!['http:', 'https:'].includes(parsed.protocol)) return 'SUPERADMIN_ALLOWED_ORIGIN must use HTTP or HTTPS.';
+    return null;
+  } catch {
+    return 'SUPERADMIN_ALLOWED_ORIGIN must be a valid origin.';
+  }
+}
+
+export function loadConfig() {
+  const production = process.env.NODE_ENV === 'production';
+  const cwd = process.cwd();
+  const sessionSecret = env('SUPERADMIN_SESSION_SECRET');
+  const encryptionKey = parseEncryptionKey(env('SUPERADMIN_ENCRYPTION_KEY'));
+  const passwordHash = env('SUPERADMIN_PASSWORD_HASH');
+  const username = env('SUPERADMIN_USERNAME');
+  const allowedOrigin = env('SUPERADMIN_ALLOWED_ORIGIN');
+  const dataDir = path.resolve(env('DATA_DIR', production ? '/var/lib/sixty-seven' : path.join(cwd, '.data')));
+  const repositoryRoot = path.resolve(env('GIT_REPOSITORY_ROOT', cwd));
+  const serverHost = env('SERVER_HOST', '127.0.0.1');
+
+  const errors = [];
+  if (!username || username.length > 128) errors.push('SUPERADMIN_USERNAME is required and must be at most 128 characters.');
+  if (!/^scrypt\$16384\$8\$1\$[A-Za-z0-9_-]{16,}\$[A-Za-z0-9_-]{32,}$/.test(passwordHash)) errors.push('SUPERADMIN_PASSWORD_HASH must be a valid 67 scrypt hash.');
+  if (Buffer.byteLength(sessionSecret, 'utf8') < 32) errors.push('SUPERADMIN_SESSION_SECRET must be at least 32 bytes.');
+  if (!encryptionKey) errors.push('SUPERADMIN_ENCRYPTION_KEY must decode to exactly 32 bytes.');
+  const originError = validateAllowedOrigin(allowedOrigin, production);
+  if (originError) errors.push(originError);
+  if (production && isPathInside(repositoryRoot, dataDir)) errors.push('DATA_DIR must be outside GIT_REPOSITORY_ROOT in production.');
+  if (!serverHost || /[\s/\\]/.test(serverHost)) errors.push('SERVER_HOST is invalid.');
+
+  return {
+    production,
+    port: intEnv('PORT', 4173, 0, 65535),
+    serverHost,
+    username,
+    passwordHash,
+    sessionSecret,
+    encryptionKey,
+    allowedOrigin,
+    dataDir,
+    repositoryRoot,
+    sessionTtlMs: intEnv('SUPERADMIN_SESSION_TTL_MINUTES', 480, 15, 1440) * 60_000,
+    githubTokenFromEnv: env('GITHUB_TOKEN'),
+    gitAuthorName: env('GIT_COMMIT_AUTHOR_NAME', '67 Superadmin'),
+    gitAuthorEmail: env('GIT_COMMIT_AUTHOR_EMAIL', 'superadmin@67.local'),
+    trustProxy: env('TRUST_PROXY') === '1',
+    configErrors: errors,
+    instanceId: crypto.createHash('sha256').update(`${cwd}:${process.pid}`).digest('hex').slice(0, 12),
+  };
+}
