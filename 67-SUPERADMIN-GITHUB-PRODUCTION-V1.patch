@@ -0,0 +1,42 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import crypto from 'node:crypto';
+import { createSession, verifySession, csrfMatches, encryptSecret, decryptSecret, redactSecrets, hashPassword, verifyPasswordHash } from './security.js';
+
+test('session signature, csrf and expiry are fail-closed', () => {
+  const secret = 's'.repeat(64);
+  const now = Date.now();
+  const { token, payload } = createSession({ username: 'root-admin', secret, ttlMs: 60_000, now });
+  assert.equal(verifySession(token, secret, now + 1_000)?.sub, 'root-admin');
+  assert.equal(csrfMatches(payload, payload.csrf), true);
+  assert.equal(csrfMatches(payload, `${payload.csrf}x`), false);
+  assert.equal(verifySession(`${token}x`, secret, now + 1_000), null);
+  assert.equal(verifySession(token, secret, now + 61_000), null);
+});
+
+test('AES-256-GCM secret storage rejects tampering', () => {
+  const key = crypto.randomBytes(32);
+  const record = encryptSecret('github_pat_example_secret_value_123456789', key);
+  assert.equal(decryptSecret(record, key), 'github_pat_example_secret_value_123456789');
+  const tampered = { ...record, ciphertext: Buffer.from('tampered').toString('base64') };
+  assert.throws(() => decryptSecret(tampered, key));
+});
+
+test('AES-GCM contexts prevent cross-purpose secret decryption', () => {
+  const key = crypto.randomBytes(32);
+  const record = encryptSecret('{"bankIBAN":"SA1234567890123"}', key, 'admin-profile');
+  assert.match(decryptSecret(record, key, 'admin-profile'), /bankIBAN/);
+  assert.throws(() => decryptSecret(record, key, 'github-token'));
+});
+
+test('redaction removes common GitHub and private key secrets', () => {
+  const output = redactSecrets('token ghp_abcdefghijklmnopqrstuvwxyz123456 and -----BEGIN PRIVATE KEY-----');
+  assert.equal(output.includes('ghp_abcdefghijklmnopqrstuvwxyz123456'), false);
+  assert.equal(output.includes('BEGIN PRIVATE KEY'), false);
+});
+
+test('scrypt password hashes verify without storing plaintext credentials', async () => {
+  const hash = await hashPassword('A-strong-admin-password-67!');
+  assert.equal(await verifyPasswordHash('A-strong-admin-password-67!', hash), true);
+  assert.equal(await verifyPasswordHash('wrong-password-value', hash), false);
+});
