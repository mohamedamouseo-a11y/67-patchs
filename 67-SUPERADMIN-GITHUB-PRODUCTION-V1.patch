+++ b/server/config.test.js
@@ -0,0 +1,47 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+import os from 'node:os';
+import { loadConfig } from './config.js';
+
+const VALID_HASH = 'scrypt$16384$8$1$abcdefghijklmnop$abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-';
+
+function withEnv(overrides, fn) {
+  const before = { ...process.env };
+  Object.assign(process.env, overrides);
+  try { return fn(); } finally {
+    for (const key of Object.keys(process.env)) if (!(key in before)) delete process.env[key];
+    Object.assign(process.env, before);
+  }
+}
+
+test('production config rejects origin paths and DATA_DIR inside repository', () => {
+  const repo = path.join(os.tmpdir(), '67-config-repo');
+  const cfg = withEnv({
+    NODE_ENV: 'production',
+    SUPERADMIN_USERNAME: 'admin',
+    SUPERADMIN_PASSWORD_HASH: VALID_HASH,
+    SUPERADMIN_SESSION_SECRET: 's'.repeat(64),
+    SUPERADMIN_ENCRYPTION_KEY: Buffer.alloc(32, 7).toString('base64'),
+    SUPERADMIN_ALLOWED_ORIGIN: 'https://67.example.com/admin',
+    GIT_REPOSITORY_ROOT: repo,
+    DATA_DIR: path.join(repo, '.data'),
+  }, () => loadConfig());
+  assert.ok(cfg.configErrors.some((value) => value.includes('exact origin')));
+  assert.ok(cfg.configErrors.some((value) => value.includes('outside GIT_REPOSITORY_ROOT')));
+});
+
+test('production config accepts exact HTTPS origin and external DATA_DIR', () => {
+  const cfg = withEnv({
+    NODE_ENV: 'production',
+    SUPERADMIN_USERNAME: 'admin',
+    SUPERADMIN_PASSWORD_HASH: VALID_HASH,
+    SUPERADMIN_SESSION_SECRET: 's'.repeat(64),
+    SUPERADMIN_ENCRYPTION_KEY: Buffer.alloc(32, 9).toString('base64'),
+    SUPERADMIN_ALLOWED_ORIGIN: 'https://67.example.com',
+    GIT_REPOSITORY_ROOT: '/srv/sixty-seven',
+    DATA_DIR: '/var/lib/sixty-seven',
+    SERVER_HOST: '127.0.0.1',
+  }, () => loadConfig());
+  assert.deepEqual(cfg.configErrors, []);
+});
