+        await this.git(['push', state.binding.selected.repoUrl, `${commitSha}:refs/heads/${state.binding.branch}`], { network: true, timeout: 180_000 });
+      } else if (expectedAction === 'push') {
+        if (pushMode === 'off') throw new Error('GitHub push mode is Off.');
+        await this.assertSafeLocalGitConfig();
+        await this.git(['push', state.binding.selected.repoUrl, `${state.head}:refs/heads/${state.binding.branch}`], { network: true, timeout: 180_000 });
+      } else if (expectedAction === 'safe_maintenance') {
+        await this.assertSafeLocalGitConfig();
+        await this.git(['fetch', '--prune', '--no-tags', state.binding.selected.repoUrl, '+refs/heads/*:refs/remotes/origin/*'], { network: true, timeout: 120_000 });
+        await this.git(['gc', '--auto'], { timeout: 120_000 });
+      }
+      operation.status = 'completed';
+      operation.completedAt = new Date().toISOString();
+      operation.result = { expectedAction };
+      return operation;
+    } catch (error) {
+      operation.status = 'failed';
+      operation.completedAt = new Date().toISOString();
+      operation.error = cleanError(error);
+      throw error;
+    } finally {
+      this.pruneOperations();
+    }
+  }
+
+  getOperation(id) { return this.operations.get(String(id)) || null; }
+  pruneOperations() {
+    const cutoff = Date.now() - 60 * 60_000;
+    for (const [id, op] of this.operations) if (Date.parse(op.startedAt) < cutoff) this.operations.delete(id);
+  }
+
+  async status(selection, pushMode) {
+    let git = { available: false, error: null };
+    if (selection?.repo && selection?.branch) {
+      try {
+        const state = await this.rawState(selection, { fetch: false });
+        git = { available: true, repo: state.binding.selected.fullName, branch: state.localBranch, head: state.head, remoteSha: state.remoteSha, ahead: state.ahead, behind: state.behind, dirty: state.dirty, fileCount: state.files.length };
+      } catch (error) { git = { available: false, error: cleanError(error) }; }
+    }
+    return { git, pushMode };
+  }
+}
+
+function cryptoRandomId() {
+  return crypto.randomUUID();
+}
