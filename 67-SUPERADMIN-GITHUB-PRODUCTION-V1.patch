+import React, { useCallback, useEffect, useMemo, useState } from 'react';
+import {
+  AlertTriangle, ArrowLeftRight, CheckCircle2, ChevronDown, CircleOff, Code2,
+  FileCode2, GitBranch, Github, KeyRound, Loader2, LockKeyhole, RefreshCw,
+  Server, ShieldCheck, ShieldX, Trash2, XCircle,
+} from 'lucide-react';
+import './GitHubModule.css';
+
+async function api(path, options = {}) {
+  const response = await fetch(path, {
+    credentials: 'same-origin',
+    ...options,
+    headers: {
+      ...(options.body ? { 'Content-Type': 'application/json' } : {}),
+      ...(options.headers || {}),
+    },
+  });
+  if (response.status === 204) return null;
+  let data = null;
+  try { data = await response.json(); } catch {}
+  if (!response.ok) {
+    const error = new Error(data?.error || `Request failed (${response.status})`);
+    error.status = response.status;
+    error.code = data?.code;
+    throw error;
+  }
+  return data;
+}
+
+function SecurityBadge({ ok, children }) {
+  return <span className={`sa-security-badge ${ok ? 'ok' : 'bad'}`}>{ok ? <ShieldCheck size={14} /> : <ShieldX size={14} />}{children}</span>;
+}
+
+function StatusPill({ tone = 'neutral', children }) {
+  return <span className={`sa-pill ${tone}`}>{children}</span>;
+}
+
+const actions = [
+  { id: 'pull', label: 'Pull', description: 'جلب آخر تحديثات الريموت بـ Fast-Forward فقط', icon: GitBranch },
+  { id: 'push', label: 'Push', description: 'مراجعة التغييرات ثم Commit + Push متحكم فيه', icon: Github },
+  { id: 'sync', label: 'Sync', description: 'تحديد الاتجاه الآمن تلقائياً حسب حالة Local/Remote', icon: ArrowLeftRight },
+  { id: 'cleanup', label: 'Safe Cleanup', description: 'Prune للـremote refs + Git GC بدون حذف ملفات العمل', icon: Trash2 },
+];
+
+export default function GitHubModule({ session, onSessionExpired }) {
+  const [status, setStatus] = useState(null);
+  const [busy, setBusy] = useState('');
+  const [notice, setNotice] = useState(null);
+  const [token, setToken] = useState('');
+  const [repositories, setRepositories] = useState([]);
+  const [branches, setBranches] = useState([]);
+  const [repo, setRepo] = useState('');
+  const [branch, setBranch] = useState('');
+  const [review, setReview] = useState(null);
+  const [commitMessage, setCommitMessage] = useState('');
+  const [auditEvents, setAuditEvents] = useState([]);
+  const csrfHeaders = useMemo(() => session?.csrfToken ? { 'X-CSRF-Token': session.csrfToken } : {}, [session?.csrfToken]);
+
+  const showNotice = (type, message) => setNotice({ type, message });
+  const handleError = useCallback(async (error) => {
+    if (error?.status === 401) await onSessionExpired?.();
+    else showNotice('error', error?.message || 'تعذر تنفيذ العملية.');
+  }, [onSessionExpired]);
+
+  const loadStatus = useCallback(async () => {
+    setBusy((current) => current || 'status');
+    try {
+      const data = await api('/api/developer-hub/status');
+      setStatus(data);
+      if (data.selection) {
+        setRepo(data.selection.repo || '');
+        setBranch(data.selection.branch || '');
+      }
+      return data;
+    } catch (error) {
+      await handleError(error);
+      return null;
+    } finally {
+      setBusy((current) => current === 'status' ? '' : current);
+    }
+  }, [handleError]);
+
+  const loadAudit = useCallback(async () => {
+    try {
+      const data = await api('/api/superadmin/audit?limit=80');
+      setAuditEvents((data.events || []).filter((event) => String(event.action || '').startsWith('GITHUB_')));
+    } catch (error) { await handleError(error); }
+  }, [handleError]);
+
+  useEffect(() => { loadStatus(); loadAudit(); }, [loadStatus, loadAudit]);
+
+  const loadRepositories = useCallback(async () => {
+    setBusy('repositories');
+    try {
+      const data = await api('/api/developer-hub/github-repositories');
+      setRepositories(data.repositories || []);
+    } catch (error) { await handleError(error); }
+    finally { setBusy(''); }
+  }, [handleError]);
+
+  const loadBranches = useCallback(async (repoName) => {
+    if (!repoName) { setBranches([]); return; }
+    setBusy('branches');
+    try {
+      const data = await api(`/api/developer-hub/github-branches?repo=${encodeURIComponent(repoName)}`);
+      setBranches(data.branches || []);
+    } catch (error) { await handleError(error); }
+    finally { setBusy(''); }
+  }, [handleError]);
+
+  useEffect(() => {
+    if (status?.github?.connected && !repositories.length) loadRepositories();
+  }, [status?.github?.connected, repositories.length, loadRepositories]);
+
+  useEffect(() => {
+    if (repo && status?.github?.connected) loadBranches(repo);
+  }, [repo, status?.github?.connected, loadBranches]);
+
+  const connectGithub = async (event) => {
+    event.preventDefault();
+    setBusy('connect');
+    try {
+      await api('/api/developer-hub/github-auth', { method: 'POST', headers: csrfHeaders, body: JSON.stringify({ token }) });
+      setToken(''); setRepositories([]); setReview(null);
+      await loadStatus(); await loadAudit();
+      showNotice('success', 'تم ربط GitHub وحفظ التوكن مشفراً على السيرفر.');
+    } catch (error) { await handleError(error); }
+    finally { setBusy(''); }
+  };
+
+  const disconnectGithub = async () => {
+    if (!window.confirm('فصل GitHub من Superadmin؟')) return;
+    setBusy('disconnect');
+    try {
+      await api('/api/developer-hub/github-connection', { method: 'DELETE', headers: csrfHeaders });
+      setRepositories([]); setBranches([]); setRepo(''); setBranch(''); setReview(null);
+      await loadStatus(); await loadAudit();
+      showNotice('success', 'تم فصل GitHub.');
+    } catch (error) { await handleError(error); }
+    finally { setBusy(''); }
+  };
+
+  const saveSelection = async () => {
+    setBusy('selection');
+    try {
+      await api('/api/developer-hub/github-selection', { method: 'POST', headers: csrfHeaders, body: JSON.stringify({ repo, branch }) });
+      setReview(null); await loadStatus(); await loadAudit();
+      showNotice('success', 'تم ربط الـrepository والـbranch بالـDeveloper Hub.');
+    } catch (error) { await handleError(error); }
+    finally { setBusy(''); }
+  };
+
+  const setPushMode = async (mode) => {
+    setBusy('pushmode');
+    try {
+      await api('/api/developer-hub/github-push-mode', { method: 'POST', headers: csrfHeaders, body: JSON.stringify({ mode }) });
+      setReview(null); await loadStatus(); await loadAudit();
+    } catch (error) { await handleError(error); }
+    finally { setBusy(''); }
+  };
+
+  const previewAction = async (action) => {
+    setBusy(`preview-${action}`); setReview(null); setCommitMessage('');
+    try {
+      const data = await api('/api/developer-hub/github-sync-preview', { method: 'POST', headers: csrfHeaders, body: JSON.stringify({ action }) });
+      setReview(data); await loadAudit();
+      showNotice(data.blockers?.length ? 'error' : 'success', data.blockers?.length ? `العملية متوقفة بسبب ${data.blockers.length} blocker.` : `Review ${action} اكتمل. راجع النتيجة قبل التنفيذ.`);
+    } catch (error) { await handleError(error); }
+    finally { setBusy(''); }
+  };
+
+  const executeReview = async () => {
+    if (!review?.authorization) return;
+    setBusy('execute');
+    try {
+      const data = await api('/api/developer-hub/github-sync-execute', {
+        method: 'POST', headers: csrfHeaders,
+        body: JSON.stringify({
+          action: review.action,
+          authorization: review.authorization,
+          executionKind: status?.pushMode === 'auto' ? 'auto' : 'review_approved',
+          commitMessage,
+        }),
+      });
+      showNotice('success', `تم التنفيذ بنجاح: ${data.operation?.expectedAction || review.expectedAction}`);
+      setReview(null); setCommitMessage(''); await loadStatus(); await loadAudit();
+    } catch (error) { await handleError(error); setReview(null); await loadStatus(); }
+    finally { setBusy(''); }
+  };
+
+  const local = status?.local || {};
+  const security = status?.security || {};
+  return <div className="sa-shell-embedded" dir="rtl">
+    <div className="sa-content-stack">
+      <div className="sa-card-head sa-module-heading">
