+import fs from 'node:fs/promises';
+import path from 'node:path';
+
+const MAX_AUDIT_BYTES = 5 * 1024 * 1024;
+
+async function ensureDir(dir) {
+  await fs.mkdir(dir, { recursive: true, mode: 0o700 });
+  try { await fs.chmod(dir, 0o700); } catch {}
+}
+
+export class SecureStore {
+  constructor(dataDir) {
+    this.dataDir = dataDir;
+    this.configPath = path.join(dataDir, 'superadmin.json');
+    this.auditPath = path.join(dataDir, 'audit.jsonl');
+    this.configQueue = Promise.resolve();
+    this.auditQueue = Promise.resolve();
+  }
+
+  async init() { await ensureDir(this.dataDir); }
+
+  async readConfig() {
+    await this.init();
+    try {
+      const raw = await fs.readFile(this.configPath, 'utf8');
+      const parsed = JSON.parse(raw);
+      return parsed && typeof parsed === 'object' && !Array.isArray(parsed) ? parsed : {};
+    } catch (error) {
+      if (error?.code === 'ENOENT') return {};
+      throw error;
+    }
+  }
+
+  async writeConfig(next) {
+    await this.init();
+    const tmp = `${this.configPath}.${process.pid}.${Date.now()}.${Math.random().toString(16).slice(2)}.tmp`;
+    const payload = `${JSON.stringify(next, null, 2)}\n`;
+    try {
+      await fs.writeFile(tmp, payload, { mode: 0o600, flag: 'wx' });
+      await fs.rename(tmp, this.configPath);
+      try { await fs.chmod(this.configPath, 0o600); } catch {}
+    } finally {
+      try { await fs.unlink(tmp); } catch {}
+    }
+  }
+
+  async patchConfig(patch) {
+    const task = this.configQueue.then(async () => {
+      const current = await this.readConfig();
+      const next = { ...current, ...patch, updatedAt: new Date().toISOString() };
+      await this.writeConfig(next);
+      return next;
+    });
+    this.configQueue = task.catch(() => {});
+    return task;
+  }
+
+  async rotateAuditIfNeeded(incomingBytes) {
+    let stat;
+    try { stat = await fs.stat(this.auditPath); } catch (error) { if (error?.code === 'ENOENT') return; throw error; }
+    if (stat.size + incomingBytes <= MAX_AUDIT_BYTES) return;
+    const rotated = path.join(this.dataDir, 'audit.previous.jsonl');
+    try { await fs.unlink(rotated); } catch (error) { if (error?.code !== 'ENOENT') throw error; }
+    await fs.rename(this.auditPath, rotated);
+    try { await fs.chmod(rotated, 0o600); } catch {}
+  }
+
+  async appendAudit(event) {
+    const task = this.auditQueue.then(async () => {
+      await this.init();
+      const line = `${JSON.stringify(event)}\n`;
+      await this.rotateAuditIfNeeded(Buffer.byteLength(line));
+      await fs.appendFile(this.auditPath, line, { mode: 0o600 });
+      try { await fs.chmod(this.auditPath, 0o600); } catch {}
+    });
+    this.auditQueue = task.catch(() => {});
+    return task;
+  }
+
+  async readAudit(limit = 100) {
+    await this.init();
+    try {
+      const raw = await fs.readFile(this.auditPath, 'utf8');
+      return raw.trim().split('\n').filter(Boolean).slice(-Math.min(Math.max(limit, 1), 250)).reverse().map((line) => {
+        try { return JSON.parse(line); } catch { return null; }
+      }).filter(Boolean);
+    } catch (error) {
+      if (error?.code === 'ENOENT') return [];
+      throw error;
+    }
+  }
+}
