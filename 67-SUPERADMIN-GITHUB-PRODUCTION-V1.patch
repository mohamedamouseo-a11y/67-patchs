+      const found = repositories.find((item) => item.fullName.toLowerCase() === repo.fullName.toLowerCase());
+      if (!found) throw new HttpError(400, 'Repository is not accessible to the connected GitHub identity.');
+      if (found.archived) throw new HttpError(400, 'Archived repositories cannot be selected.');
+      const branches = await github.listBranches(repo.fullName);
+      if (!branches.some((item) => item.name === branch)) throw new HttpError(400, 'Branch does not exist in the selected repository.');
+      const selection = { repo: repo.fullName, branch, defaultBranch: found.defaultBranch, permissions: found.permissions };
+      await store.patchConfig({ githubSelection: selection });
+      await audit(ctx, 'GITHUB_SELECTION_UPDATED', 'success', { repo: repo.fullName, branch });
+      return json(res, 200, { selection });
+    }
+
+    if (method === 'POST' && pathname === '/api/developer-hub/github-push-mode') {
+      const body = await readJson(req);
+      const mode = String(body.mode || '');
+      if (!['off', 'review', 'auto'].includes(mode)) throw new HttpError(400, 'Invalid push mode.');
+      await store.patchConfig({ githubPushMode: mode });
+      await audit(ctx, 'GITHUB_PUSH_MODE_UPDATED', 'success', { mode });
+      return json(res, 200, { pushMode: mode });
+    }
+
+    if (method === 'POST' && pathname === '/api/developer-hub/github-sync-preview') {
+      const body = await readJson(req);
+      const saved = await store.readConfig();
+      const selection = saved.githubSelection;
+      const pushMode = ['off', 'review', 'auto'].includes(saved.githubPushMode) ? saved.githubPushMode : 'review';
+      const action = String(body.action || '');
+      const preview = await github.preview({ selection, action, pushMode, sessionBinding: sessionHash(ctx.superadmin.sid) });
+      await audit(ctx, 'GITHUB_SYNC_PREVIEW', preview.blockers.length ? 'blocked' : 'success', { action, repo: preview.repo, branch: preview.branch, blockers: preview.blockers.length, files: preview.files.length });
+      return json(res, 200, preview);
+    }
+
+    if (method === 'POST' && pathname === '/api/developer-hub/github-sync-execute') {
+      const body = await readJson(req);
+      try {
+        const saved = await store.readConfig();
+        const selection = saved.githubSelection;
+        const pushMode = ['off', 'review', 'auto'].includes(saved.githubPushMode) ? saved.githubPushMode : 'review';
+        const action = String(body.action || '');
+        const executionKind = String(body.executionKind || '');
+        const auth = verifyExecutionAuthorization(body.authorization, config.sessionSecret);
+        if (!timingSafeEqualString(auth.sessionBinding, sessionHash(ctx.superadmin.sid))) throw new HttpError(403, 'Execution authorization belongs to a different Superadmin session.');
+        if (auth.pushMode === 'review' && ['push', 'commit_and_push'].includes(auth.expectedAction) && executionKind !== 'review_approved') throw new HttpError(403, 'Review mode requires explicit Superadmin approval.');
+        if (auth.pushMode === 'auto' && ['push', 'commit_and_push'].includes(auth.expectedAction) && !['auto', 'review_approved'].includes(executionKind)) throw new HttpError(403, 'Auto mode requires verified auto or explicit approval.');
+        const operation = await github.execute({ selection, authorizationPayload: auth, action, pushMode, commitMessage: body.commitMessage });
+        await audit(ctx, 'GITHUB_SYNC_EXECUTE', 'success', { action, expectedAction: operation.expectedAction, operationId: operation.id });
+        return json(res, 200, { operation });
+      } catch (error) {
+        await audit(ctx, 'GITHUB_SYNC_EXECUTE', 'failed', { action: String(body.action || ''), reason: redactSecrets(error?.message || 'execution_failed') });
+        throw error;
+      }
+    }
+
+    const operationMatch = pathname.match(/^\/api\/developer-hub\/github-sync-operation\/([0-9a-f-]{36})$/i);
+    if (method === 'GET' && operationMatch) {
+      const operation = github.getOperation(operationMatch[1]);
+      if (!operation) throw new HttpError(404, 'Operation not found.');
+      return json(res, 200, { operation });
+    }
+  }
+
+  throw new HttpError(404, 'API route not found.');
+}
+
+const MIME = new Map([
+  ['.html', 'text/html; charset=utf-8'], ['.js', 'text/javascript; charset=utf-8'], ['.mjs', 'text/javascript; charset=utf-8'],
+  ['.css', 'text/css; charset=utf-8'], ['.json', 'application/json; charset=utf-8'], ['.svg', 'image/svg+xml'], ['.png', 'image/png'],
+  ['.jpg', 'image/jpeg'], ['.jpeg', 'image/jpeg'], ['.gif', 'image/gif'], ['.webp', 'image/webp'], ['.ico', 'image/x-icon'],
+  ['.woff', 'font/woff'], ['.woff2', 'font/woff2'], ['.txt', 'text/plain; charset=utf-8'],
+]);
+
+async function sendFile(req, res, filePath, { noStore = false } = {}) {
+  const stat = await fs.stat(filePath);
+  if (!stat.isFile()) throw new HttpError(404, 'Not found.');
+  res.statusCode = 200;
+  res.setHeader('Content-Type', MIME.get(path.extname(filePath).toLowerCase()) || 'application/octet-stream');
+  res.setHeader('Content-Length', stat.size);
+  res.setHeader('Cache-Control', noStore ? 'no-store' : config.production ? 'public, max-age=3600' : 'no-store');
+  if (req.method === 'HEAD') return res.end();
+  const handle = await fs.open(filePath, 'r');
+  const stream = handle.createReadStream();
+  stream.on('error', () => { try { res.destroy(); } catch {} });
+  stream.pipe(res);
+}
+
+async function handleStatic(ctx, url) {
+  const { req, res } = ctx;
+  if (!['GET', 'HEAD'].includes(req.method || '')) throw new HttpError(404, 'Not found.');
+  let decoded;
+  try { decoded = decodeURIComponent(url.pathname); } catch { throw new HttpError(400, 'Invalid URL path.'); }
+  const segments = decoded.split('/').filter(Boolean);
+  if (segments.some((segment) => segment.startsWith('.') || segment === '..' || segment.includes('\0'))) throw new HttpError(404, 'Not found.');
+  const relative = segments.join('/');
+  const candidate = path.resolve(distDir, relative || 'index.html');
+  if (candidate !== distDir && !candidate.startsWith(`${distDir}${path.sep}`)) throw new HttpError(404, 'Not found.');
+  if (relative) {
+    try { return await sendFile(req, res, candidate, { noStore: path.basename(candidate) === 'index.html' }); } catch (error) { if (error?.code !== 'ENOENT' && error?.status !== 404) throw error; }
+  }
+  const acceptsHtml = String(req.headers.accept || '').includes('text/html');
+  if (!relative || acceptsHtml) return sendFile(req, res, path.join(distDir, 'index.html'), { noStore: true });
+  throw new HttpError(404, 'Not found.');
+}
+
+async function requestHandler(req, res) {
+  const requestId = crypto.randomUUID();
+  const ctx = { req, res, requestId, superadmin: null };
+  res.setHeader('X-Request-Id', requestId);
+  setSecurityHeaders(res);
+  try {
+    const url = new URL(req.url || '/', 'http://127.0.0.1');
+    if (url.pathname.startsWith('/api/')) await handleApi(ctx, url);
+    else await handleStatic(ctx, url);
+  } catch (error) {
+    if (res.headersSent) { try { res.destroy(); } catch {} return; }
+    const message = redactSecrets(error?.message || 'Internal server error.');
+    const status = Number.isSafeInteger(error?.status) ? error.status : validationStatus(message);
+    if (status >= 500) console.error(`[${requestId}]`, message);
+    const exposed = config.production && status >= 500 ? 'Internal server error.' : message;
+    json(res, status, { error: exposed, ...(error?.code ? { code: error.code } : {}), requestId });
+  }
+}
+
+const server = http.createServer({ requestTimeout: 30_000, headersTimeout: 15_000, keepAliveTimeout: 5_000, maxHeaderSize: 16 * 1024 }, requestHandler);
+server.listen(config.port, config.serverHost, () => {
+  if (config.configErrors.length) {
+    console.error('67 Superadmin is FAIL-CLOSED. Fix these environment settings before login:');
+    for (const error of config.configErrors) console.error(`- ${error}`);
+  }
+  const address = server.address();
+  const actualPort = address && typeof address === 'object' ? address.port : config.port;
+  console.log(`67 server listening on ${config.serverHost}:${actualPort}`);
+});
+
+function shutdown(signal) {
+  console.log(`${signal}: shutting down`);
+  server.close(() => process.exit(0));
+  setTimeout(() => process.exit(1), 10_000).unref();
+}
+process.on('SIGTERM', () => shutdown('SIGTERM'));
+process.on('SIGINT', () => shutdown('SIGINT'));
