new file mode 100644
index 0000000..35888b5
--- /dev/null
+++ b/server/githubSecurity.js
@@ -0,0 +1,119 @@
+import crypto from 'node:crypto';
+import path from 'node:path';
+
+const REPO_PART = /^[A-Za-z0-9_.-]+$/;
+const SOURCE_ROOTS = new Set(['src','server','scripts','tests','test','public','assets','static','docs','.github']);
+const ROOT_ALLOWLIST = new Set(['.gitignore','.dockerignore','.editorconfig','package.json','package-lock.json','vite.config.js','vite.config.ts','index.html','README.md','SECURITY.md','LICENSE']);
+const SOURCE_EXTENSIONS = /\.(?:[cm]?[jt]sx?|json|md|mdx|txt|ya?ml|css|scss|sass|less|html|svg|png|jpe?g|gif|webp|avif|ico|sh)$/i;
+const BLOCKED_DIRS = new Set(['.git','node_modules','dist','build','coverage','.cache','tmp','.ssh','.aws','.azure','.gcloud','storage','uploads','logs','downloads','backups','backup','.data']);
+const BLOCKED_BASENAMES = new Set(['.env','.envrc','.npmrc','.netrc','credentials.json','service-account.json','service_account.json','.gitmodules','ecosystem.config.cjs','superadmin.json','audit.jsonl']);
+const BLOCKED_EXTENSIONS = /\.(?:pem|key|p12|pfx|ppk|jks|keystore|sqlite|sqlite3|db|dump|zip|7z|rar|tar|tgz|gz|backup|bak|orig|rej|log)$/i;
+const ENV_SAMPLE = /^\.env(?:\.[A-Za-z0-9_-]+)*\.(?:example|sample|template)$/i;
+const SAFE_ROOT_DOC = /^(?:README|SECURITY|CHANGELOG|CONTRIBUTING|CODE_OF_CONDUCT|LICENSE|NOTICE)(?:[._-].+)?$/i;
+
+export function normalizeGitHubRepo(input) {
+  const raw = String(input ?? '').trim();
+  if (!raw) throw new Error('GitHub repository is required.');
+  let candidate = raw;
+  if (/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+(?:\.git)?$/.test(candidate)) candidate = `https://github.com/${candidate}`;
+  else if (/^git@github\.com:/i.test(candidate)) candidate = candidate.replace(/^git@github\.com:/i, 'https://github.com/');
+  else if (/^ssh:\/\/git@github\.com\//i.test(candidate)) candidate = candidate.replace(/^ssh:\/\/git@github\.com\//i, 'https://github.com/');
+  let parsed;
+  try { parsed = new URL(candidate); } catch { throw new Error('Invalid GitHub repository URL.'); }
+  if (parsed.protocol !== 'https:' || parsed.hostname.toLowerCase() !== 'github.com' || parsed.port || parsed.username || parsed.password || parsed.search || parsed.hash) throw new Error('Only canonical github.com repository URLs are supported.');
+  const parts = parsed.pathname.replace(/^\/+|\/+$/g, '').split('/');
+  if (parts.length !== 2) throw new Error('Repository URL must be owner/repository.');
+  const owner = parts[0];
+  const repo = parts[1].replace(/\.git$/i, '');
+  if (!REPO_PART.test(owner) || !REPO_PART.test(repo)) throw new Error('Invalid GitHub owner/repository.');
+  return { owner, repo, fullName: `${owner}/${repo}`, repoUrl: `https://github.com/${owner}/${repo}.git` };
+}
+
+export function assertSafeBranch(value) {
+  const branch = String(value ?? '').trim();
+  if (!branch || branch.length > 240 || branch.startsWith('-') || branch.startsWith('.') || branch.endsWith('.') || branch.endsWith('.lock')) throw new Error('Invalid branch name.');
+  if (!/^[A-Za-z0-9._/-]+$/.test(branch) || branch.includes('..') || branch.includes('//') || branch.includes('@{')) throw new Error('Invalid branch name.');
+  return branch;
+}
+
+export function normalizeRepoPath(filePath) {
+  const normalized = String(filePath ?? '').replace(/\\/g, '/').replace(/^\.\//, '').replace(/\/+/g, '/');
+  if (!normalized || normalized.includes('\0') || normalized.startsWith('/') || /^[A-Za-z]:\//.test(normalized)) return null;
+  if (normalized.split('/').some((segment) => !segment || segment === '.' || segment === '..')) return null;
+  return normalized;
+}
+
+export function blockedPathReason(filePath) {
+  const normalized = normalizeRepoPath(filePath);
+  if (!normalized) return 'invalid repository-relative path';
+  const segments = normalized.split('/');
+  const lowerSegments = segments.map((segment) => segment.toLowerCase());
+  const base = lowerSegments.at(-1);
+  if (lowerSegments.some((segment) => BLOCKED_DIRS.has(segment))) return 'runtime/secret/generated directory is excluded';
+  if (BLOCKED_BASENAMES.has(base) && !ENV_SAMPLE.test(base)) return 'sensitive configuration file is excluded';
+  if (/^\.env(?:\.|$)/i.test(base) && !ENV_SAMPLE.test(base)) return 'environment secret file is excluded';
+  if (BLOCKED_EXTENSIONS.test(base)) return 'sensitive/generated/archive file type is excluded';
+  if (/^\.github\/workflows\//i.test(normalized)) return 'workflow changes require out-of-band review';
+  return null;
+}
+
+export function isSafeSourcePath(filePath) {
+  const normalized = normalizeRepoPath(filePath);
+  if (!normalized || blockedPathReason(normalized)) return false;
+  const segments = normalized.split('/');
+  if (segments.length === 1) return ROOT_ALLOWLIST.has(normalized) || ENV_SAMPLE.test(normalized) || SAFE_ROOT_DOC.test(normalized);
+  if (!SOURCE_ROOTS.has(segments[0])) return false;
+  return SOURCE_EXTENSIONS.test(path.posix.basename(normalized));
+}
+
+const SECRET_PATTERNS = [
+  ['GitHub token', /\b(?:github_pat_[A-Za-z0-9_]{20,}|gh[pousr]_[A-Za-z0-9_]{20,})\b/g],
+  ['AWS access key', /\b(?:AKIA|ASIA)[0-9A-Z]{16}\b/g],
+  ['Google API key', /\bAIza[0-9A-Za-z_-]{30,}\b/g],
+  ['Slack token', /\bxox[baprs]-[A-Za-z0-9-]{20,}\b/g],
+  ['private key', /-----BEGIN (?:ENCRYPTED |RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----/g],
+  ['live payment key', /\b(?:sk|rk)_live_[A-Za-z0-9]{12,}\b/g],
+];
+
+export function scanTextForSecrets(text) {
+  const findings = [];
+  for (const [label, pattern] of SECRET_PATTERNS) {
+    pattern.lastIndex = 0;
+    if (pattern.test(String(text ?? ''))) findings.push(label);
+  }
+  return findings;
+}
+
+export function createReviewFingerprint(input, secret) {
+  const canonical = JSON.stringify(input);
+  return crypto.createHmac('sha256', secret).update('67/developer-hub/review/v1\0').update(canonical).digest('base64url');
+}
+
+export function createExecutionAuthorization(payload, secret) {
+  const body = Buffer.from(JSON.stringify(payload)).toString('base64url');
+  const sig = crypto.createHmac('sha256', secret).update('67/developer-hub/execute/v1\0').update(body).digest('base64url');
+  return `${body}.${sig}`;
+}
+
+export function verifyExecutionAuthorization(token, secret, now = Date.now()) {
+  const raw = String(token ?? '');
+  if (!raw || raw.length > 16384) throw new Error('Invalid execution authorization.');
+  const [body, sig, extra] = raw.split('.');
+  if (!body || !sig || extra) throw new Error('Invalid execution authorization.');
+  const expected = crypto.createHmac('sha256', secret).update('67/developer-hub/execute/v1\0').update(body).digest('base64url');
+  const a = Buffer.from(sig); const b = Buffer.from(expected);
+  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) throw new Error('Invalid execution authorization signature.');
+  let payload;
+  try { payload = JSON.parse(Buffer.from(body, 'base64url').toString('utf8')); } catch { throw new Error('Invalid execution authorization payload.'); }
+  if (payload?.v !== 1 || !payload.fingerprint || !payload.repo || !payload.branch || !payload.action || !payload.sessionBinding) throw new Error('Incomplete execution authorization.');
+  if (typeof payload.fingerprint !== 'string' || payload.fingerprint.length > 256 || typeof payload.sessionBinding !== 'string' || payload.sessionBinding.length > 256) throw new Error('Invalid execution authorization binding.');
+  if (!['pull','push','sync','cleanup'].includes(payload.action)) throw new Error('Invalid execution authorization action.');
+  if (!['safe_maintenance','fast_forward_pull','nothing_to_pull','push','nothing_to_push','commit_and_push','already_synced'].includes(payload.expectedAction)) throw new Error('Invalid execution authorization expected action.');
+  if (!['off','review','auto'].includes(payload.pushMode)) throw new Error('Invalid execution authorization push mode.');
+  if (!Number.isSafeInteger(payload.fileCount) || payload.fileCount < 0) throw new Error('Invalid execution authorization file count.');
+  if (!Number.isSafeInteger(payload.iat) || !Number.isSafeInteger(payload.exp) || payload.iat > now + 30_000 || payload.exp <= now || payload.exp <= payload.iat || payload.exp - payload.iat > 10 * 60_000) throw new Error('Execution authorization expired or invalid.');
+  if (['push','commit_and_push'].includes(payload.expectedAction)) {
+    if (payload.checks?.verify !== 'passed' || payload.checks?.tests !== 'passed' || payload.checks?.build !== 'passed') throw new Error('Execution authorization checks are incomplete.');
+  }
+  return payload;
+}
