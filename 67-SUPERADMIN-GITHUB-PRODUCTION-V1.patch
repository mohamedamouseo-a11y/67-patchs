+++ b/server/github.js
@@ -0,0 +1,689 @@
+import crypto from 'node:crypto';
+import { execFile } from 'node:child_process';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import { promisify } from 'node:util';
+import {
+  assertSafeBranch,
+  blockedPathReason,
+  createExecutionAuthorization,
+  createReviewFingerprint,
+  isSafeSourcePath,
+  normalizeGitHubRepo,
+  normalizeRepoPath,
+  scanTextForSecrets,
+} from './githubSecurity.js';
+import { redactSecrets } from './security.js';
+
+const execFileAsync = promisify(execFile);
+const MAX_OUTPUT = 8 * 1024 * 1024;
+const OPERATION_TTL_MS = 10 * 60_000;
+const MAX_SECRET_SCAN_BYTES = 2 * 1024 * 1024;
+const SAFE_LARGE_BINARY_EXTENSIONS = /\.(?:png|jpe?g|gif|webp|avif|ico|woff2?|ttf|otf|pdf)$/i;
+
+function cleanError(error) {
+  const text = error?.stderr || error?.stdout || error?.message || String(error);
+  return redactSecrets(String(text).slice(0, 4000));
+}
+
+async function run(command, args, options = {}) {
+  try {
+    const result = await execFileAsync(command, args, {
+      cwd: options.cwd,
+      env: options.env || process.env,
+      timeout: options.timeout || 60_000,
+      maxBuffer: MAX_OUTPUT,
+      windowsHide: true,
+      encoding: 'utf8',
+    });
+    return { stdout: result.stdout || '', stderr: result.stderr || '' };
+  } catch (error) {
+    const wrapped = new Error(cleanError(error));
+    wrapped.code = error?.code;
+    throw wrapped;
+  }
+}
+
+function parseStatus(raw) {
+  const chunks = String(raw || '').split('\0');
+  const entries = [];
+  for (let i = 0; i < chunks.length; i += 1) {
+    const record = chunks[i];
+    if (!record || record.length < 4) continue;
+    const status = record.slice(0, 2);
+    const filePath = record.slice(3);
+    const entry = { status, path: filePath };
+    if (status.includes('R') || status.includes('C')) {
+      const originalPath = chunks[i + 1];
+      if (originalPath) { entry.originalPath = originalPath; i += 1; }
+    }
+    entries.push(entry);
+  }
+  return entries;
+}
+
+function parseNameStatus(raw) {
+  const chunks = String(raw || '').split('\0');
+  const entries = [];
+  for (let i = 0; i < chunks.length; i += 1) {
+    const statusRaw = chunks[i];
+    if (!statusRaw) continue;
+    const code = statusRaw.slice(0, 1);
+    if (!/^[ACDMRTUXB]$/.test(code)) continue;
+    if (code === 'R' || code === 'C') {
+      const originalPath = chunks[i + 1];
+      const filePath = chunks[i + 2];
+      if (filePath) entries.push({ status: code, path: filePath, originalPath });
+      i += 2;
+      continue;
+    }
+    const filePath = chunks[i + 1];
+    if (filePath) entries.push({ status: code, path: filePath });
+    i += 1;
+  }
+  return entries;
+}
+
+function parseCount(raw) {
+  const [left = '0', right = '0'] = String(raw).trim().split(/\s+/);
+  return { ahead: Number(left) || 0, behind: Number(right) || 0 };
+}
+
+async function exists(file) {
+  try { await fs.access(file); return true; } catch { return false; }
+}
+
+export class GitHubService {
+  constructor({ config, store, getToken, audit }) {
+    this.config = config;
+    this.store = store;
+    this.getToken = getToken;
+    this.audit = audit;
+    this.operations = new Map();
+  }
+
+  async githubApi(apiPath, { method = 'GET', body, token } = {}) {
+    const authToken = token || await this.getToken();
+    if (!authToken) throw new Error('GitHub is not connected.');
+    const url = new URL(apiPath, 'https://api.github.com');
+    if (url.origin !== 'https://api.github.com') throw new Error('Invalid GitHub API target.');
+    const response = await fetch(url, {
+      method,
+      headers: {
+        Accept: 'application/vnd.github+json',
+        Authorization: `Bearer ${authToken}`,
+        'User-Agent': '67-superadmin-developer-hub',
+        ...(body ? { 'Content-Type': 'application/json' } : {}),
+      },
+      body: body ? JSON.stringify(body) : undefined,
+      signal: AbortSignal.timeout(25_000),
+    });
+    const text = await response.text();
+    let data = null;
+    try { data = text ? JSON.parse(text) : null; } catch { data = null; }
+    if (!response.ok) {
+      const message = data?.message || `GitHub API error ${response.status}`;
+      throw new Error(redactSecrets(message));
+    }
+    return { data, headers: response.headers };
+  }
+
+  async validateToken(token) {
+    const raw = String(token || '').trim();
+    if (raw.length < 20 || raw.length > 512 || /\s/.test(raw)) throw new Error('Invalid GitHub token format.');
+    const { data, headers } = await this.githubApi('/user', { token: raw });
+    return {
+      token: raw,
+      account: {
+        login: data.login,
+        id: data.id,
+        avatarUrl: data.avatar_url,
+        profileUrl: data.html_url,
+      },
+      scopes: String(headers.get('x-oauth-scopes') || '').split(',').map((v) => v.trim()).filter(Boolean),
+    };
+  }
+
+  async listRepositories() {
+    const repos = [];
+    for (let page = 1; page <= 3; page += 1) {
+      const { data } = await this.githubApi(`/user/repos?per_page=100&page=${page}&sort=updated&affiliation=owner%2Ccollaborator%2Corganization_member`);
+      if (!Array.isArray(data)) break;
+      repos.push(...data.map((repo) => ({
+        id: repo.id,
+        fullName: repo.full_name,
+        private: Boolean(repo.private),
+        defaultBranch: repo.default_branch,
+        permissions: repo.permissions || {},
+        archived: Boolean(repo.archived),
+        htmlUrl: repo.html_url,
+      })));
+      if (data.length < 100) break;
+    }
+    return repos;
+  }
+
+  async listBranches(repoInput) {
+    const repo = normalizeGitHubRepo(repoInput);
+    const branches = [];
+    for (let page = 1; page <= 3; page += 1) {
+      const { data } = await this.githubApi(`/repos/${encodeURIComponent(repo.owner)}/${encodeURIComponent(repo.repo)}/branches?per_page=100&page=${page}`);
+      if (!Array.isArray(data)) break;
+      branches.push(...data.map((branch) => ({ name: branch.name, protected: Boolean(branch.protected), sha: branch.commit?.sha || null })));
+      if (data.length < 100) break;
+    }
+    return branches;
+  }
+
+  childEnv(extra = {}) {
+    const allow = ['PATH', 'SystemRoot', 'WINDIR', 'TEMP', 'TMP', 'TMPDIR', 'LANG', 'LC_ALL', 'TZ'];
+    const env = {};
+    for (const key of allow) if (process.env[key]) env[key] = process.env[key];
+    env.HOME = path.join(this.config.dataDir, 'child-home');
+    env.GIT_CONFIG_GLOBAL = process.platform === 'win32' ? 'NUL' : '/dev/null';
+    env.GIT_CONFIG_SYSTEM = process.platform === 'win32' ? 'NUL' : '/dev/null';
+    env.GIT_TERMINAL_PROMPT = '0';
+    env.GCM_INTERACTIVE = 'Never';
+    env.GIT_PAGER = 'cat';
+    env.PAGER = 'cat';
+    return { ...env, ...extra };
+  }
+
+  gitSecurityArgs(args) {
+    return [
