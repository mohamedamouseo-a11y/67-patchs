+function ReviewPanel({ review, commitMessage, setCommitMessage, busy, onExecute, onCancel }) {
+  const canExecute = Boolean(review.authorization) && !review.blockers?.length;
+  const needsCommit = review.expectedAction === 'commit_and_push';
+  return <article className="sa-card sa-review-card">
+    <div className="sa-card-head"><div><span className="sa-kicker">SIGNED REVIEW</span><h2>{review.action.toUpperCase()} · {review.expectedAction}</h2></div><StatusPill tone={canExecute ? 'success' : 'danger'}>{canExecute ? 'READY' : 'BLOCKED'}</StatusPill></div>
+    <div className="sa-review-summary"><div><span>Repo</span><strong>{review.repo}</strong></div><div><span>Branch</span><strong>{review.branch}</strong></div><div><span>Ahead / Behind</span><strong>{review.ahead} / {review.behind}</strong></div><div><span>Files</span><strong>{review.files?.length || 0}</strong></div><div><span>Authorization</span><strong>{review.authorization ? 'Signed · 10 min max' : 'Not issued'}</strong></div></div>
+    <div className="sa-checks"><div className={review.checks.verify === 'passed' ? 'ok' : 'bad'}>{review.checks.verify === 'passed' ? <CheckCircle2 /> : <XCircle />}Verify <b>{review.checks.verify}</b></div><div className={review.checks.tests === 'passed' || review.checks.tests === 'skipped' ? 'ok' : 'bad'}>{review.checks.tests === 'failed' ? <XCircle /> : <CheckCircle2 />}Tests <b>{review.checks.tests}</b></div><div className={review.checks.build === 'passed' || review.checks.build === 'skipped' ? 'ok' : 'bad'}>{review.checks.build === 'failed' ? <XCircle /> : <CheckCircle2 />}Build <b>{review.checks.build}</b></div></div>
+    {!!review.blockers?.length && <div className="sa-blockers"><h3><ShieldX size={18} />Blockers</h3>{review.blockers.map((item, i) => <div key={`${item.path}-${i}`}><code>{item.path}</code><span>{item.reason}</span></div>)}</div>}
+    {!!review.files?.length && <div className="sa-files"><h3>Approved file set</h3>{review.files.slice(0, 100).map((file, i) => <div key={`${file.path}-${i}`}><code>{file.status}</code><span>{file.path}</span></div>)}{review.files.length > 100 && <small>+ {review.files.length - 100} files</small>}</div>}
+    {needsCommit && canExecute && <label className="sa-commit">Commit message (اختياري)<input value={commitMessage} onChange={(e) => setCommitMessage(e.target.value)} maxLength={120} placeholder="Verified 67 update…" /></label>}
+    <div className="sa-review-actions"><button className="sa-secondary" onClick={onCancel}>إلغاء</button><button className="sa-primary" onClick={onExecute} disabled={!canExecute || busy === 'execute'}>{busy === 'execute' ? <Loader2 className="spin" size={18} /> : <ShieldCheck size={18} />}Approve & Execute</button></div>
+  </article>;
+}
