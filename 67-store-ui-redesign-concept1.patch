+  .section-heading>p { text-align:right; }
+  .services-grid { grid-template-columns:1fr; }
+  .service-card { min-height:190px; }
+  .trust-strip { grid-template-columns:1fr; padding:10px 16px; }
+  .trust-item,.trust-item:nth-last-child(-n+2) { justify-content:flex-start; padding:12px 2px; border-bottom:1px solid #eeeae1; }
+  .trust-item:last-child { border-bottom:0; }
+  .offers-card { min-height:260px; padding:30px 24px; border-radius:20px; }
