+  .main-nav { position:absolute; top:calc(100% + 1px); right:16px; left:16px; padding:12px; border:1px solid var(--67-line); border-radius:16px; background:#fff; box-shadow:0 18px 40px rgba(30,28,23,.12); display:none; flex-direction:column; align-items:stretch; gap:2px; }
+  .main-nav--open { display:flex; }
+  .main-nav a { padding:11px 12px; border-radius:10px; }
+  .main-nav a:hover { background:var(--67-cream); }
+  .mobile-menu-button { display:inline-grid; }
+  .header-cta,.icon-button--search { display:none; }
+  .hero-premium__grid { grid-template-columns:1fr; padding-top:58px; padding-bottom:94px; }
+  .hero-copy { max-width:none; }
+  .hero-copy h1,.hero-copy>p { max-width:700px; }
+  .hero-visual { min-height:315px; }
+  .vehicle-finder__header { flex-direction:column; }
+  .finder-progress { width:100%; min-width:0; }
+  .brand-grid { grid-template-columns:repeat(4,minmax(0,1fr)); }
+  .model-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }
+  .year-selector-card { grid-template-columns:1fr 1fr; }
+  .finder-submit { grid-column:1/-1; }
+  .trust-strip { grid-template-columns:repeat(2,1fr); gap:0; }
+  .trust-item { border-left:0; border-bottom:1px solid #eeeae1; }
+  .trust-item:nth-last-child(-n+2) { border-bottom:0; }
+  .offers-card { align-items:flex-start; flex-direction:column; }
+}
+@media (max-width:620px) {
+  .promo-strip__message { max-width:205px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
+  .promo-strip__link { font-size:11px; }
+  .site-header__inner { min-height:66px; }
+  .brand__logo-wrap { width:38px; height:38px; }
+  .brand__name,.icon-button--user { display:none; }
+  .header-actions { margin-inline-start:auto; }
+  .hero-premium__grid { padding-top:44px; padding-bottom:78px; gap:34px; }
+  .hero-copy h1 { font-size:38px; letter-spacing:-.7px; }
+  .hero-copy>p { font-size:14px; }
+  .hero-btn { width:100%; }
+  .hero-proof { display:grid; gap:9px; }
+  .hero-visual { min-height:280px; padding:18px; border-radius:22px; }
+  .hero-car-icon { width:160px; }
+  .hero-car-stage__circle { width:200px; height:200px; }
+  .floating-part { font-size:10px; }
+  .finder-section { margin-top:-42px; }
+  .vehicle-finder { padding:20px 14px; border-radius:20px; }
+  .vehicle-finder__header h2,.section-heading h2,.offers-card h2 { font-size:24px; }
+  .finder-progress__item { min-width:58px; }
+  .selection-summary { align-items:flex-start; }
+  .brand-grid { grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
+  .brand-card { min-height:104px; }
+  .model-grid { grid-template-columns:1fr; }
